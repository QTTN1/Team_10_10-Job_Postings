# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# Supabase dashboard -> Connect -> "Session pooler" connection string.
# Use the pooler string (not db.<ref>.supabase.co): the direct host is IPv6-only and
# usually fails from Docker / many home and campus networks.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
